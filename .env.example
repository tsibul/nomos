DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# на хостинге: адрес сайта со схемой, через запятую (https://example.org)
DJANGO_CSRF_TRUSTED_ORIGINS=
# HTTPS (Secure-cookie, перенаправление, HSTS); по умолчанию 1 при DJANGO_DEBUG=0
# DJANGO_HTTPS=1
# срок HSTS в секундах, 0 — без HSTS
# DJANGO_HSTS_SECONDS=31536000
# 1 — за прокси, который передаёт X-Forwarded-Proto: https
# DJANGO_PROXY_SSL_HEADER=0
# куда collectstatic собирает статику (по умолчанию staticfiles/ в корне)
# DJANGO_STATIC_ROOT=
DB_NAME=nomos
DB_USER=nomos
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
NOMOS_TEXTS_DIR=../Nomos-texts
# 1 — без входа видны только выражения с public="true"
NOMOS_PUBLIC_ONLY=0
